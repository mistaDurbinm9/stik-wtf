# stik.wtf container — Caddy serves the static build; serve.py handles the dynamic bits.
# cloudflared (the tunnel) points at http://localhost:80 in this container.
# Set up together with the author at deploy time — see SITE_PLAN.md.

# www -> apex (the tunnel passes the Host header through)
http://www.stik.wtf {
	redir https://stik.wtf{uri} permanent
}

:80 {
	root * /srv/site/public
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# HTML always revalidates (cheap 304s via ETag) so nav changes appear instantly;
	# fingerprinted css/js can cache long; other assets get an hour.
	@assets path *.css *.js *.svg *.png *.ico
	header @assets Cache-Control "public, max-age=3600"
	@pages not path *.css *.js *.svg *.png *.ico
	header @pages Cache-Control "no-cache"

	handle /hook {
		reverse_proxy 127.0.0.1:8787
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		try_files {path} {path}/
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
